<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Stop_Request)[XIC(Start_PB) ,XIC(System_Run) ]OTE(System_Run);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(System_Run)XIO(Drain_Mode)XIO(Level_H)XIO(Level_HH)[XIO(Level_L) ,XIC(Fill_Request) ]OTE(Fill_Request);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(System_Run)XIC(Drain_Mode)XIC(Level_LL)OTE(Drain_Request);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Fill_Request)XIO(Drain_Request)XIO(Drain_Output)OTE(Inlet_Output);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Drain_Request)XIO(Fill_Request)XIO(Inlet_Output)OTE(Drain_Output);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Level_LL)TON(LL_Alarm_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(LL_Alarm_Timer.DN)OTL(Alarm_LL);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Level_HH)TON(HH_Alarm_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HH_Alarm_Timer.DN)OTL(Alarm_HH);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Alarm_Reset)ONS(Reset_ONS)OTE(Reset_Pulse);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Reset_Pulse)XIC(Level_LL)OTU(Alarm_LL);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Reset_Pulse)XIO(Level_HH)OTU(Alarm_HH);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(Alarm_LL) ,XIC(Alarm_HH) ]OTE(Alarm_Output);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
